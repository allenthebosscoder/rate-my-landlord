# Copy to .env for local overrides (or export these directly in your shell).
# Every value has a dev-friendly default in application.properties, so none
# of this is required to run locally — only needed to point at a different
# database, lock down CORS, or actually send email for a real deployment.
DB_USERNAME=postgres
DB_PASSWORD=password
DB_URL=jdbc:postgresql://localhost:5432/ratemylandlord
CORS_ORIGINS=*
LOG_SQL=true

# Comma-separated usernames that become admin on registration/login. Leave
# empty for local dev (first account ever registered becomes admin instead).
# Set this before a real deployment — otherwise anyone who registers first
# on a public site becomes admin.
ADMIN_USERNAMES=

# Used to build password-reset links (must point at the frontend).
FRONTEND_URL=http://localhost:3000

# Password reset email. Mocked by default — nothing is actually sent, and
# the reset link is logged instead so the flow works with zero setup. Set
# MAIL_MOCK=false and fill in real SMTP details to actually send mail.
MAIL_MOCK=true
MAIL_FROM=noreply@ratemylandlord.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_START_TLS=DISABLED
