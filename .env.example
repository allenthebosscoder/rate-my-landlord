# Copy to .env for local overrides (or export these directly in your shell).
# Every value has a dev-friendly default in application.properties, so none
# of this is required to run locally — only needed to point at a different
# database or lock down CORS for a real deployment.
DB_USERNAME=postgres
DB_PASSWORD=password
DB_URL=jdbc:postgresql://localhost:5432/ratemylandlord
CORS_ORIGINS=*
LOG_SQL=true
